{
  // Tarefas para rodar o projeto sem digitar comandos: Terminal → Run Task…
  "version": "2.0.0",
  "options": {
    "shell": {
      "executable": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-Command"]
    }
  },
  "tasks": [
    {
      "label": "Instalar Node.js (só na primeira vez)",
      "detail": "Instala o Node.js LTS pelo winget. O Windows vai pedir permissão de administrador.",
      "type": "shell",
      "command": "winget install --id OpenJS.NodeJS.LTS --exact --source winget --accept-source-agreements --accept-package-agreements",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "Rodar o site",
      "detail": "Instala as dependências e abre o site no navegador (npm install + npm run dev).",
      "type": "shell",
      "command": "$env:Path = [Environment]::GetEnvironmentVariable('Path','Machine') + ';' + [Environment]::GetEnvironmentVariable('Path','User'); npm.cmd install; npm.cmd run dev -- --open",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^__never_matches__$" },
        "background": {
          "activesBegin": "VITE",
          "beginsPattern": "VITE",
          "endsPattern": "Local:"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true },
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
